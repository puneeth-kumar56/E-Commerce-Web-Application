# =====================================================================
# NovaMart E-Commerce Environment Configuration
# Copy this file to .env and adjust values for your local environment
# =====================================================================

# Server Port (Default: 3000)
PORT=3000
NODE_ENV=development

# JSON Web Token Secret & Expiration
# In production, use a strong random string (e.g. openssl rand -base64 32)
JWT_SECRET=novamart_super_secret_jwt_key_2026_internship_task
JWT_EXPIRES_IN=7d

# MySQL Database Configuration
# Leave DB_HOST blank or commented if you want to use the built-in resilient in-memory database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=novamart_db
DB_CONNECTION_LIMIT=10

# Gemini AI API Key (Optional, provided automatically by AI Studio)
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=http://localhost:3000
